# Copy to server/.env (git-ignored). Real environment variables override this file.

# --- Storage + staff sign-in: Supabase (recommended) ---
# Project Settings > API (or "API Keys"). Use the SECRET / service_role key. Server only, never in a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# --- ...or local mode, if the two Supabase values above are empty ---
# LIFELINE_ADMIN_PASSWORD=pick-something-long
# LIFELINE_PATIENTS=patients.json

# --- Links in alert texts point here. Use your ngrok/https URL when phones are off your Wi-Fi.
LIFELINE_PUBLIC_URL=http://localhost:8080

# --- Alerts ---
LIFELINE_NOTIFIER=console
# LIFELINE_NOTIFIER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

ESCALATE_AFTER_SECONDS=120
OFFLINE_AFTER_SECONDS=90
