# Copy to server/.env (git-ignored). Real environment variables override this file.
# Hosted: this file is NOT deployed. Azure App Service: `server/deploy_azure.py settings` turns it into
# app settings (the zip from `deploy_azure.py package` never contains it). Fly.io (plan B): fly.toml [env]
# plus `fly secrets import`. See docs/ops/deploy.md. Hosted needs Supabase: local JSON files don't
# survive a redeploy.
# Secrets: SUPABASE_SECRET_KEY, NTFY_TOPIC, NTFY_TOKEN, TWILIO_AUTH_TOKEN, LIFELINE_SESSION_SECRET,
#          LIFELINE_RESPOND_SECRET, LIFELINE_ADMIN_PASSWORD.

# --- HTTP ---
# PORT=8080
# Address to listen on (default 0.0.0.0). Behind a proxy on the same host, use 127.0.0.1.
# LIFELINE_BIND=0.0.0.0
# Behind a proxy that sets the caller's real address in a header it overwrites, name that header so
# sign-in throttling counts each caller, not the proxy. Fly.io: Fly-Client-IP. Azure: leave unset (unverified). Leave unset when
# people connect directly (laptop), or anyone could fake their address.
# LIFELINE_CLIENT_IP_HEADER=Fly-Client-IP
# Health check for hosts: GET /healthz -> {"ok": true} (liveness only, never touches Supabase).

# --- Storage + staff sign-in: Supabase (recommended) ---
# Project Settings > API (or "API Keys"). Use the SECRET / service_role key. Server only, never in a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# --- ...or local mode, if the two Supabase values above are empty ---
# LIFELINE_ADMIN_PASSWORD=pick-something-long
# LIFELINE_PATIENTS=patients.json

# --- Links in alert texts point here. Use your ngrok/https URL when phones are off your Wi-Fi.
#     Hosted: https://<app>.fly.dev exactly (no trailing slash); Twilio signatures are checked against it.
LIFELINE_PUBLIC_URL=http://localhost:8080

# --- Alerts ---
LIFELINE_NOTIFIER=console
# Free phone push, no account: install the ntfy app and subscribe to a long random topic.
# LIFELINE_NOTIFIER=ntfy
# NTFY_TOPIC=lifeline-<long-random-string>
# LIFELINE_NOTIFIER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# Free alternative, no number needed: Twilio's WhatsApp sandbox sender (alerts arrive on WhatsApp)
# TWILIO_FROM=whatsapp:+14155238886

ESCALATE_AFTER_SECONDS=120
# Board shows a unit as "No signal" after this much silence...
OFFLINE_AFTER_SECONDS=90
# ...and care staff on the call list are alerted after this much.
SILENT_ALERT_AFTER_SECONDS=300
# Local mode only: where incidents are kept (Supabase mode uses the outages table).
# LIFELINE_OUTAGES=outages.json
# ntfy extras: a self-hosted server and an access token for a protected topic.
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# --- Storm Watch: warnings before an outage, from api.weather.gov (free, no key) ---
# on (default), off, or demo (pretend ice storm everywhere, for showing it on a clear day)
# LIFELINE_STORM_WATCH=on
# County view: each county's power-dependent Medicare population from HHS emPOWER (public, no key).
# Sends each home's location rounded to about 1 km. on (default) or off.
# LIFELINE_EMPOWER=on
# NWS asks every app to identify itself with a contact:
# NWS_USER_AGENT=Lifeline (you@example.org)
# LIFELINE_TIMEZONE=America/Chicago
# STORM_CHECK_SECONDS=300

# --- One-tap "I'm responding" buttons in push alerts: any long random string (32+ characters) ---
# LIFELINE_RESPOND_SECRET=

# --- Roles: this email is an admin even before anyone is in the staff_roles table (migration 005).
#     Sign in with it, then give everyone else a role on the Staff tab. ---
# LIFELINE_BOOTSTRAP_ADMIN=you@youragency.org

# --- Signs staff sign-in cookies so they survive restarts (32+ random characters) ---
# LIFELINE_SESSION_SECRET=

# --- County emergency management, for patients whose call list names nobody from the county ---
#     Gets the 15-minute emergency alerts and the "send no-answer list" welfare-check requests.
#     Name|phone|sms or call; several separated by ";". A patient's own contact with "county" in its role wins.
# LIFELINE_COUNTY_CONTACT=Forrest County EMA|+16015550123|sms

# --- Demo only: units that have never reported show as "Power on" instead of "Not set up" ---
#     Lets one real prototype run among synthetic homes. A unit's own reports always win.
# LIFELINE_DEMO_ASSUME_POWER=1
